<% if (title) { %>
    <title>
    <%= title %>
    </title>
    <% } %>
    <%- messages() %>
<h1><%- title %></h1>
<table class="ticket-details">
    <thead>
        <tr>
            <th>Client First Name</th>
            <th>Client Last Name</th>
            <th>Subject</th>
            <th>Description</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
            <tr class="ticket-row <%= ticket.status %>">
                <td><%= ticket.account_firstname %></td>
                <td><%= ticket.account_lastname %></td>
                <td><%= ticket.subject %></td>
                <td><%= ticket.description %></td>
                <td><%= ticket.status.replace("_", " ") %></td>
            </tr>
    </tbody>
</table>
<button class="in-progress-button"
        data-ticket-id="<%= ticket.ticket_id %>"
        data-status="in_progress">
  In Progress
</button>

<button class="resolved-button"
        data-ticket-id="<%= ticket.ticket_id %>"
        data-status="resolved">
  Resolve
</button>

<button class="closed-button"
        data-ticket-id="<%= ticket.ticket_id %>"
        data-status="closed">
  Close
</button>

    <script src="../../js/ticket-status.js"></script>