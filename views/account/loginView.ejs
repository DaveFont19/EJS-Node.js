                    <% if (title) { %>
            <title>
                <%= title %>
            </title>
            <% } %>
            <%- messages() %>
    <h1 class="account-management"><%- title %></h1>
    <div class="account-management-links">
         <% if( locals.accountData.account_type == "Admin" || locals.accountData.account_type == "Employee") { %>
            <h2>Welcome <%= locals.accountData.account_firstname %></h2>
            <p>You're logged in</p>
            <a class="account-link-edit" href="/account/edit">Edit account Information</a>
            <h3>Inventory Management</h3>
            <a href="/inv/">Manage Inventory</a>
            <h3>Ticket Management</h3>
            <a href="/ticket/ticket-inventory">See Tickets</a>
        <% } else { %>
            <h2>Welcome <%= locals.accountData.account_firstname %></h2>
            <p>You're logged in</p>
            <a href="/account/edit">Edit account Information</a>
            <h3>My tickets Status</h3>
            <a href="/ticket/my-tickets">View My Tickets</a>
        <% } %>
        </div>
