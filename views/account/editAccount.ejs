<% if (title) { %>
    <title>
        <%= title %>
    </title>
   <% } %>
<%- messages() %>
<h1 class="edit-account"><%- title %></h1>
<section class="form-login">
    <div>
    <form action="/account/edit-information" method="post">
        <input type="hidden" name="account_id" value="<%= locals.accountData.account_id %>">
        <label for="account_firstname">First Name:</label>
        <input type="text" id="account_firstname" name="account_firstname" value="<%= locals.accountData.account_firstname %>" required>

        <label for="account_lastname">Last Name:</label>
        <input type="text" id="account_lastname" name="account_lastname" value="<%= locals.accountData.account_lastname %>" required>

        <label for="account_email">Email:</label>
        <input type="email" id="account_email" name="account_email" value="<%= locals.accountData.account_email %>" required>

        <button type="submit">Update Account</button>
    </form>
    <h2>Update Password</h2>
    <span>Password must be at least 12 characters and contain at least 1 number, 1 capital letter, and 1 special character.<br>
    *Note your original password will be changed.</span>
    <form action="/account/edit-password" method="post">
        <input type="hidden" name="account_id" value="<%= locals.accountData.account_id %>">
        <label for="account_password" >Password: </label>
         <input required type="password" name="account_password" id="account_password" pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$">
        <button type="submit">Update Password</button>
    </form>
    </div>
</section>